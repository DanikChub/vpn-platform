# =========================
# Database
# =========================

DB_NAME=vpn_db
DB_USER=postgres
DB_PASSWORD=change_me


# =========================
# VPN nodes
# =========================

VPN_NODE_SSH_PRIVATE_KEY_PATH=/path/to/vpn_nodes_key

NODE_AGENT_TOKEN=change_me
AGENT_CONTROL_SERVER_URL=ws://127.0.0.1:15000/ws/agent


# =========================
# Crypto Pay
# =========================

CRYPTO_PAY_TOKEN=change_me
CRYPTO_PAY_API_URL=https://testnet-pay.crypt.bot/api
CRYPTO_PAY_WEBHOOK_SECRET=change_me


# =========================
# YooKassa
# =========================

YOOKASSA_SHOP_ID=change_me
YOOKASSA_SECRET_KEY=change_me
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_RETURN_URL=https://example.com/payment/return


# =========================
# Application
# =========================

PUBLIC_API_URL=https://api.example.com

NODE_ENV=development
ENABLE_TEST_PAYMENTS=true


# =========================
# Admin authentication
# =========================

ADMIN_JWT_SECRET=change_me
ADMIN_JWT_EXPIRES_IN=8h

SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change_me


# =========================
# Telegram bot
# =========================

BOT_TOKEN=change_me